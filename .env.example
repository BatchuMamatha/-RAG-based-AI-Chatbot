# ==============================================================================
# Agentic AI eBook RAG Chatbot - Configuration Environment File
# ==============================================================================

# Knowledge Base File Path
PDF_PATH=Ebook-Agentic-AI.pdf

# ------------------------------------------------------------------------------
# Vector Database Configuration (Pinecone or ChromaDB)
# Options: 'auto' (uses Pinecone if PINECONE_API_KEY is present, else ChromaDB),
#          'pinecone', or 'chroma'
# ------------------------------------------------------------------------------
VECTOR_DB_TYPE=auto

# Pinecone Cloud Settings (Required if VECTOR_DB_TYPE=pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=agentic-ai-ebook
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Local ChromaDB Persistence Directory (Used when running offline / zero-cloud)
CHROMA_PERSIST_DIR=./chroma_db

# ------------------------------------------------------------------------------
# Embedding Model Settings
# Options: 'huggingface' (Free local offline), 'openai', or 'gemini'
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=huggingface
HF_EMBEDDING_MODEL=all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ------------------------------------------------------------------------------
# LLM Engine Settings
# Options: 'auto', 'openai', 'gemini', 'groq', or 'local_fallback'
# ------------------------------------------------------------------------------
LLM_PROVIDER=auto

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq Configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# Retrieval & RAG Parameters
# ------------------------------------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
MIN_RELEVANCE_SCORE=0.25

# ------------------------------------------------------------------------------
# Server Options
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
